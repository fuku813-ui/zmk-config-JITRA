#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <200>;
};

&trackball {
    automouse-layer = <3>;
    scroll-layers = <4>;
};

/ {
    macros {
        // 矢印キーを連打してスクロール量を PG_UP/PG_DN の約25%程度に抑える
        scroll_up_qtr: scroll_up_qtr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp UP>, <&kp UP>, <&kp UP>, <&kp UP>, <&kp UP>;
        };

        scroll_down_qtr: scroll_down_qtr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp DOWN>, <&kp DOWN>, <&kp DOWN>, <&kp DOWN>, <&kp DOWN>;
        };
    };

    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&scroll_up_qtr>, <&scroll_down_qtr>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ─── Layer 0: DEFAULT (Mac JIS) ───────────────────────────────
        default_layer {
            display-name = "DEFAULT";
            bindings = <
// Row 0 (15 keys): ESC 1-5 | 6-0 - ^(=) ¥(INT3) BS
&kp ESC    &kp N1   &kp N2   &kp N3   &kp N4      &kp N5
           &kp N6   &kp N7   &kp N8   &kp N9      &kp N0    &kp MINUS  &kp EQUAL  &kp INT3   &kp BSPC
// Row 1 (14 keys): TAB Q-T | Y-P @(LBKT) [(RBKT) | ENTER(tall)
&kp TAB    &kp Q    &kp W    &kp E    &kp R       &kp T
           &kp Y    &kp U    &kp I    &kp O       &kp P     &kp LBKT   &kp RBKT               &kp ENTER
// Row 2 (13 keys): CAPS A-G | H-L ;(SEMI) :(SQT) ENTER(small)
&kp CAPS   &kp A    &kp S    &kp D    &kp F       &kp G
           &kp H    &kp J    &kp K    &kp L       &kp SEMI  &kp SQT    &kp ENTER
// Row 3 (14 keys): LSHFT Z-B [LOWER] | N-/ ろ(INT1) RSHFT
&kp LSHFT  &kp Z    &kp X    &kp C    &kp V       &kp B     &mo 1
           &kp N    &kp M    &kp COMMA &kp DOT    &kp SLASH &kp INT1   &kp RSHFT
// Row 4 (9 keys): LCTRL ⌘ ⌥ 英数/[LWR] SPACE | かな/[RSE] ⌘ ⌥ CTRL
&kp LCTRL  &kp LGUI &kp LALT &lt 1 LANG2          &kp SPACE
           &lt 2 LANG1 &kp RGUI &kp RALT           &kp RCTRL
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        // ─── Layer 1: LOWER (F keys / Navigation / Media) ─────────────
        lower_layer {
            display-name = "LOWER";
            bindings = <
// Row 0: ` F1-F5 | F6-F10 F11 F12 DEL ---
&kp GRAVE  &kp F1   &kp F2   &kp F3   &kp F4      &kp F5
           &kp F6   &kp F7   &kp F8   &kp F9      &kp F10   &kp F11    &kp F12    &kp DEL    &trans
// Row 1: --- | --- 輝度↓ 輝度↑ | ---
&trans     &trans   &trans   &trans   &trans      &trans
           &trans   &trans   &trans   &trans      &trans    &kp C_BRI_DN &kp C_BRI_UP          &trans
// Row 2: --- | ← ↓ ↑ → --- ---
&trans     &trans   &trans   &trans   &trans      &trans
           &kp LEFT &kp DOWN &kp UP   &kp RIGHT   &trans    &trans     &trans
// Row 3: --- --- | Home PgDn PgUp End --- ---
&trans     &trans   &trans   &trans   &trans      &trans    &trans
           &kp HOME &kp PG_DN &kp PG_UP &kp END   &trans    &trans     &trans
// Row 4: --- | --- Vol- Vol+
&trans     &trans   &trans   &trans              &trans
           &trans   &trans   &kp C_VOL_DN        &kp C_VOL_UP
            >;
        };

        // ─── Layer 2: RAISE (Bluetooth) ───────────────────────────────
        raise_layer {
            display-name = "RAISE";
            bindings = <
// Row 0: --- | --- BT_CLR(BSPCの位置)
&trans     &trans   &trans   &trans   &trans      &trans
           &trans   &trans   &trans   &trans      &trans    &trans     &trans     &trans     &bt BT_CLR
// Row 1: ---
&trans     &trans   &trans   &trans   &trans      &trans
           &trans   &trans   &trans   &trans      &trans    &trans     &trans                 &trans
// Row 2: ---
&trans     &trans   &trans   &trans   &trans      &trans
           &trans   &trans   &trans   &trans      &trans    &trans     &trans
// Row 3: ---
&trans     &trans   &trans   &trans   &trans      &trans    &trans
           &trans   &trans   &trans   &trans      &trans    &trans     &trans
// Row 4: --- | --- BT0 BT1 BT2
&trans     &trans   &trans   &trans              &trans
           &trans   &bt BT_SEL 0 &bt BT_SEL 1   &bt BT_SEL 2
            >;
        };

        // ─── Layer 3: MOUSE (トラックボール自動起動) ──────────────────
        mouse_layer {
            display-name = "MOUSE";
            bindings = <
// Row 0-1: ---
&trans     &trans   &trans   &trans   &trans      &trans
           &trans   &trans   &trans   &trans      &trans    &trans     &trans     &trans     &trans
&trans     &trans   &trans   &trans   &trans      &trans
           &trans   &trans   &trans   &trans      &trans    &trans     &trans                 &trans
// Row 2: --- | MB1(左) MB3(中) MB2(右) ---
&trans     &trans   &trans   &trans   &trans      &trans
           &mkp MB1 &mkp MB3 &mkp MB2 &trans      &trans    &trans     &trans
// Row 3: ---
&trans     &trans   &trans   &trans   &trans      &trans    &trans
           &trans   &trans   &trans   &trans      &trans    &trans     &trans
// Row 4: --- SPACE=MB1 | MB2 ---
&trans     &trans   &trans   &trans              &mkp MB1
           &mkp MB2 &trans   &trans              &trans
            >;
        };

        // ─── Layer 4: SCROLL (スクロールモード) ───────────────────────
        scroll_layer {
            display-name = "SCROLL";
            bindings = <
&trans     &trans   &trans   &trans   &trans      &trans
           &trans   &trans   &trans   &trans      &trans    &trans     &trans     &trans     &trans
&trans     &trans   &trans   &trans   &trans      &trans
           &trans   &trans   &trans   &trans      &trans    &trans     &trans                 &trans
&trans     &trans   &trans   &trans   &trans      &trans
           &trans   &trans   &trans   &trans      &trans    &trans     &trans
&trans     &trans   &trans   &trans   &trans      &trans    &trans
           &trans   &trans   &trans   &trans      &trans    &trans     &trans
&trans     &trans   &trans   &trans              &trans
           &trans   &trans   &trans              &trans
            >;
        };
    };
};
