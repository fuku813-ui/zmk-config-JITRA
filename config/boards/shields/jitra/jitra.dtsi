#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &jitra_physical_layout;
    };

    jitra_physical_layout: jitra_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";

        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys
            /* Row 0: 15 keys (w h x y rot rx ry) */
            = <&key_physical_attrs 100 100    0    0    0 0 0>
            , <&key_physical_attrs 100 100  100    0    0 0 0>
            , <&key_physical_attrs 100 100  200    0    0 0 0>
            , <&key_physical_attrs 100 100  300    0    0 0 0>
            , <&key_physical_attrs 100 100  400    0    0 0 0>
            , <&key_physical_attrs 100 100  500    0    0 0 0>
            , <&key_physical_attrs 100 100  725    0    0 0 0>
            , <&key_physical_attrs 100 100  825    0    0 0 0>
            , <&key_physical_attrs 100 100  925    0    0 0 0>
            , <&key_physical_attrs 100 100 1025    0    0 0 0>
            , <&key_physical_attrs 100 100 1125    0    0 0 0>
            , <&key_physical_attrs 100 100 1225    0    0 0 0>
            , <&key_physical_attrs 100 100 1325    0    0 0 0>
            , <&key_physical_attrs 100 100 1425    0    0 0 0>
            , <&key_physical_attrs 100 100 1525    0    0 0 0>

            /* Row 1: 14 keys */
            , <&key_physical_attrs 150 100    0  100    0 0 0>
            , <&key_physical_attrs 100 100  150  100    0 0 0>
            , <&key_physical_attrs 100 100  250  100    0 0 0>
            , <&key_physical_attrs 100 100  350  100    0 0 0>
            , <&key_physical_attrs 100 100  450  100    0 0 0>
            , <&key_physical_attrs 100 100  550  100    0 0 0>
            , <&key_physical_attrs 100 100  775  100    0 0 0>
            , <&key_physical_attrs 100 100  875  100    0 0 0>
            , <&key_physical_attrs 100 100  975  100    0 0 0>
            , <&key_physical_attrs 100 100 1075  100    0 0 0>
            , <&key_physical_attrs 100 100 1175  100    0 0 0>
            , <&key_physical_attrs 100 100 1275  100    0 0 0>
            , <&key_physical_attrs 100 100 1375  100    0 0 0>
            , <&key_physical_attrs 125 200 1500  100    0 0 0>

            /* Row 2: 13 keys */
            , <&key_physical_attrs 175 100    0  200    0 0 0>
            , <&key_physical_attrs 100 100  175  200    0 0 0>
            , <&key_physical_attrs 100 100  275  200    0 0 0>
            , <&key_physical_attrs 100 100  375  200    0 0 0>
            , <&key_physical_attrs 100 100  475  200    0 0 0>
            , <&key_physical_attrs 100 100  575  200    0 0 0>
            , <&key_physical_attrs 100 100  800  200    0 0 0>
            , <&key_physical_attrs 100 100  900  200    0 0 0>
            , <&key_physical_attrs 100 100 1000  200    0 0 0>
            , <&key_physical_attrs 100 100 1100  200    0 0 0>
            , <&key_physical_attrs 100 100 1200  200    0 0 0>
            , <&key_physical_attrs 100 100 1300  200    0 0 0>
            , <&key_physical_attrs 100 100 1400  200    0 0 0>

            /* Row 3: 14 keys */
            , <&key_physical_attrs 125 100    0  300    0 0 0>
            , <&key_physical_attrs 100 100  125  300    0 0 0>
            , <&key_physical_attrs 100 100  225  300    0 0 0>
            , <&key_physical_attrs 100 100  325  300    0 0 0>
            , <&key_physical_attrs 100 100  425  300    0 0 0>
            , <&key_physical_attrs 100 100  525  300    0 0 0>
            , <&key_physical_attrs 100 100  625  300    0 0 0>
            , <&key_physical_attrs 100 100  850  300    0 0 0>
            , <&key_physical_attrs 100 100  950  300    0 0 0>
            , <&key_physical_attrs 100 100 1050  300    0 0 0>
            , <&key_physical_attrs 100 100 1150  300    0 0 0>
            , <&key_physical_attrs 100 100 1250  300    0 0 0>
            , <&key_physical_attrs 100 100 1350  300    0 0 0>
            , <&key_physical_attrs 175 100 1450  300    0 0 0>

            /* Row 4: 9 keys (thumb clusters; encoder/trackball are not kscan keys) */
            , <&key_physical_attrs 125 100    0  400    0 0 0>
            , <&key_physical_attrs 125 100  125  400    0 0 0>
            , <&key_physical_attrs 125 100  250  400    0 0 0>
            , <&key_physical_attrs 100 100  375  400    0 0 0>
            , <&key_physical_attrs 200 100  475  400    0 0 0>
            , <&key_physical_attrs 125 100  900  400    0 0 0>
            , <&key_physical_attrs 125 100 1150  400    0 0 0>
            , <&key_physical_attrs 125 100 1275  400    0 0 0>
            , <&key_physical_attrs 100 100 1400  400    0 0 0>
            ;
    };

    /* columns = left(6) + right(7); right-side shield adds col-offset = <6> */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <13>;
        rows = <5>;

        map = <
            /* Row 0: ESC 1-5 | 6-0 - ^ ¥ BS */
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)     RC(0,6) RC(0,7) RC(1,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(1,12)
            /* Row 1: TAB Q-T | Y-P @ [ ENTER(tall) */
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)     RC(1,6) RC(2,7) RC(1,8) RC(2,8) RC(1,9) RC(1,10) RC(1,11) RC(2,12)
            /* Row 2: CAPS A-G | H-L ; : ENTER(small) */
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)     RC(2,6) RC(3,7) RC(3,8) RC(2,9) RC(3,9) RC(2,10) RC(2,11)
            /* Row 3: LSHFT Z-B MO1 | N-/ INT1(ろ) RSHFT */
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(4,5)     RC(3,6) RC(4,7) RC(4,8) RC(4,9) RC(3,10) RC(3,11) RC(3,12)
            /* Row 4: LCTRL LGUI LALT LWR SPACE | RSE RGUI RALT RCTRL */
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)             RC(4,6) RC(4,10) RC(4,11) RC(4,12)
        >;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <12>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <10>;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };
};

&spi0 {
    status = "disabled";

    trackball: trackball@0 {
        status = "disabled";
        reg = <0>;
    };
};
